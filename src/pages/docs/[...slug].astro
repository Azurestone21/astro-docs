---
// src/pages/docs/[...slug].astro
import Layout from "@layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

// 定义文档条目的类型别名（可选，让代码更简洁）
type DocEntry = CollectionEntry<"docs">;

export async function getStaticPaths() {
  try {
    const allDocs = await getCollection("docs");

    const paths = allDocs.map((doc) => {
      const slug = doc.id === "index" ? "" : doc.id;
      return {
        params: { slug: slug },
        props: { doc },
      };
    });

    return paths;
  } catch (error) {
    console.error("getStaticPaths 出错：", error);
    return []; // 避免挂掉，返回空数组
  }
}

// 显式声明 props 的类型
const { doc } = Astro.props as { doc: DocEntry };
const { Content } = await render(doc);

// 提取标题生成右侧 TOC
const headings =
  doc.body?.match(/^#{1,3}\s+(.+)$/gm)?.map((line: any) => {
    const level = line.match(/^#{1,3}/)[0].length;
    const text = line.replace(/^#{1,3}\s+/, "");
    const id = text
      .toLowerCase()
      .replace(/\s+/g, "-")
      .replace(/[^\w\u4e00-\u9fa5-]/g, "");
    return { level, text, id };
  }) || [];

// 左侧导航需要的所有文档列表（可以不缓存，Astro 会自动优化）
const allDocs = await getCollection("docs");
const docsList = new Map();
allDocs?.forEach((docItem: any) => {
  const category = docItem.data.category || "other";
  const existing = docsList.get(category) || [];
  docsList.set(category, [...existing, docItem]);
});
---

<Layout>
  <div class="doc-container">
    <aside class="sidebar">
      {
        Array.from(docsList.entries()).map(([category, docs]) => (
          <div>
            <div class="category-title">{category}</div>
            <ul>
              {docs
                ?.sort((a: any, b: any) => a.data.weight - b.data.weight)
                ?.map((docItem: any) => {
                  const href = docItem.id === "index" ? "/docs" : `/docs/${docItem.id}`;
                  return (
                    <li>
                      <a href={href}>{docItem.data.title || docItem.id}</a>
                    </li>
                  );
                })}
            </ul>
          </div>
        ))
      }
    </aside>

    <main class="doc-content">
      <Content />
    </main>

    <aside class="doc-toc">
      {
        headings.length ? (
          <ul>
            {headings.map((h: any) => (
              <li style={{ marginLeft: `${(h.level - 1) * 1}rem` }}>
                <a href={`#${h.id}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        ) : (
          <></>
        )
      }
    </aside>
  </div>
</Layout>

<script>
  // 获取当前URL
  const currentUrl = window.location.href;
  // 获取所有文章标题
  const articleTitles = document.querySelectorAll(".sidebar a");

  // 遍历文章标题
  articleTitles.forEach((title) => {
    // 如果标题的链接与当前URL匹配
    if ((title as HTMLAnchorElement).href === currentUrl) {
      // 高亮标题
      title.classList.add("active");
    }
  });

  // 监听滚动事件
  window.addEventListener("scroll", () => {
    // 获取所有目录项
    const tocItems = document.querySelectorAll(".doc-toc a");
    // 获取所有标题
    const headings = document.querySelectorAll("h1, h2, h3");

    // 遍历标题
    headings.forEach((heading) => {
      // 获取标题的位置
      const rect = heading.getBoundingClientRect();
      // 如果标题在视口中
      if (rect.top <= 100 && rect.bottom >= 100) {
        // 移除所有目录项的高亮
        tocItems.forEach((item) => {
          item.classList.remove("active");
        });
        // 高亮当前目录项
        const currentTocItem = document.querySelector(
          `.doc-toc a[href="#${heading.id}"]`,
        );
        if (currentTocItem) {
          currentTocItem.classList.add("active");
        }
      }
    });
  });
</script>
